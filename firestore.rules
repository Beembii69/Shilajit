rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', '').lower(); }
    function role() {
      let userEmail = email();
      return userEmail == 'belguutei66@gmail.com' ? 'admin'
        : userEmail == '7enkhbold@gmail.com' ? 'founder'
        : userEmail == 'bayanaa1250@gmail.com' ? 'accountant'
        : userEmail == 'bbolor0411@gmail.com' ? 'production' : '';
    }
    function staff() { return signedIn() && request.auth.token.email_verified == true && role() != ''; }
    function manager() { return staff() && role() in ['admin', 'founder']; }
    function staffName() {
      let userRole = role();
      return userRole == 'admin' ? 'ADMIN' : userRole == 'founder' ? 'У. Энхболд'
        : userRole == 'accountant' ? 'О. Баянжаргал' : 'А. Болормаа';
    }
    function stockEditor() { return staff() && role() in ['admin','accountant','production']; }
    function stockBefore(key) {
      return exists(/databases/$(database)/documents/inventory/$(key))
        ? get(/databases/$(database)/documents/inventory/$(key)).data : {'onHand':0,'reserved':0};
    }
    function orderQuantity(order, key) {
      return order.get('items', {}).get(key, order.get('product','') == key ? order.get('qty',1) : 0);
    }
    function validDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function dateTimestamp(date) {
      return timestamp.date(int(date.split('-')[0]),int(date.split('-')[1]),int(date.split('-')[2]));
    }
    function today() { return (request.time + duration.value(8,'h')).date(); }
    function validPhoto(path, kind, recordId) {
      let parts = path.split('/');
      return path is string && parts.size() == 5
        && parts[0] == 'stock-photos' && parts[1] == request.auth.uid
        && parts[2] == kind && parts[3] == recordId && parts[4].size() > 0;
    }
    match /stockWorkdays/{date} {
      allow read: if staff();
      allow create: if stockEditor() && validDate(date)
        && dateTimestamp(date).dayOfWeek() == 6 && dateTimestamp(date) >= today()
        && request.resource.data.date == date
        && request.resource.data.actorName == staffName() && request.resource.data.actorEmail == email()
        && request.resource.data.timestamp == request.time
        && request.resource.data.keys().hasOnly(['date','actorName','actorEmail','timestamp']);
      allow update, delete: if false;
    }
    match /stockCounts/{date} {
      function validCount(key) {
        let item = request.resource.data.items[key];
        let after = getAfter(/databases/$(database)/documents/inventory/$(key)).data;
        return item.keys().hasOnly(['expected','actual','difference'])
          && item.difference == item.actual - item.expected
          && (item.difference == 0 || request.resource.data.note.size() > 0)
          && after.onHand == item.actual
          && after.action == 'closing' && after.countDate == date && after.updatedAt == request.time;
      }
      allow read: if staff();
      allow create: if stockEditor() && validDate(date) && dateTimestamp(date) == today()
        && (today().dayOfWeek() <= 5 || (today().dayOfWeek() == 6 && exists(/databases/$(database)/documents/stockWorkdays/$(date))))
        && request.resource.data.date == date
        && request.resource.data.actorName == staffName() && request.resource.data.actorEmail == email()
        && request.resource.data.timestamp == request.time
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.actorUid == request.auth.uid
        && (!('photoPath' in request.resource.data) || validPhoto(request.resource.data.photoPath,'closing',date))
        && request.resource.data.keys().hasOnly(['date','items','note','photoPath','actorUid','actorName','actorEmail','timestamp'])
        && request.resource.data.items.keys().hasAll(['p1','p2','p3','p4','p5','p6','p7'])
        && request.resource.data.items.keys().hasOnly(['p1','p2','p3','p4','p5','p6','p7'])
        && validCount('p1') && validCount('p2') && validCount('p3') && validCount('p4') && validCount('p5') && validCount('p6') && validCount('p7');
      allow update, delete: if false;
    }
    match /stockWithdrawals/{withdrawalId} {
      function withdrawn(key) {
        let quantity = request.resource.data.items.get(key,0);
        return quantity == 0 || (quantity is int && quantity > 0 && quantity <= 1000000
          && getAfter(/databases/$(database)/documents/inventory/$(key)).data.withdrawalId == withdrawalId
          && getAfter(/databases/$(database)/documents/inventory/$(key)).data.action == 'withdrawal'
          && getAfter(/databases/$(database)/documents/inventory/$(key)).data.updatedAt == request.time);
      }
      allow read: if staff();
      allow create: if staff() && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName == staffName() && request.resource.data.actorEmail == email()
        && request.resource.data.timestamp == request.time
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 1000
        && ((!request.resource.data.keys().hasAny(['receiptPath','roomPath']))
          || (request.resource.data.keys().hasAll(['receiptPath','roomPath'])
            && validPhoto(request.resource.data.receiptPath,'receipt',withdrawalId) && validPhoto(request.resource.data.roomPath,'room',withdrawalId)))
        && request.resource.data.items is map && request.resource.data.items.size() > 0
        && request.resource.data.items.keys().hasOnly(['p1','p2','p3','p4','p5','p6','p7'])
        && request.resource.data.keys().hasOnly(['items','note','receiptPath','roomPath','actorUid','actorName','actorEmail','timestamp'])
        && withdrawn('p1') && withdrawn('p2') && withdrawn('p3') && withdrawn('p4') && withdrawn('p5') && withdrawn('p6') && withdrawn('p7');
      allow update, delete: if false;
    }
    match /stockMovements/{movementId} {
      allow read: if staff();
      allow create: if stockEditor()
        && request.resource.data.product in ['p1','p2','p3','p4','p5','p6','p7']
        && request.resource.data.quantity is int && request.resource.data.quantity > 0 && request.resource.data.quantity <= 1000000
        && request.resource.data.before == stockBefore(request.resource.data.product).onHand
        && request.resource.data.after == request.resource.data.before + request.resource.data.quantity
        && getAfter(/databases/$(database)/documents/inventory/$(request.resource.data.product)).data.onHand == request.resource.data.after
        && getAfter(/databases/$(database)/documents/inventory/$(request.resource.data.product)).data.movementId == movementId
        && request.resource.data.actorName == staffName() && request.resource.data.actorEmail == email()
        && request.resource.data.timestamp == request.time
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 500
        && request.resource.data.keys().hasOnly(['product','quantity','before','after','note','actorName','actorEmail','timestamp']);
      allow update, delete: if false;
    }
    match /inventory/{key} {
      function validOrderMovement() {
        let before = resource == null ? {'onHand':0,'reserved':0} : resource.data;
        let order = get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
        let after = getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
        let quantity = orderQuantity(order,key);
        let data = request.resource.data;
        return quantity is int && quantity > 0 && after.updatedAt == request.time && after.updatedByEmail == email()
          && ((data.action == 'approved' && after.status == 'approved' && order.get('status','new') in ['new','called']
            && !order.get('stockReserved',false) && after.stockReserved == true
            && data.onHand == before.onHand && data.reserved == before.reserved + quantity)
          || (data.action == 'cancelled' && after.status == 'cancelled' && order.stockReserved == true && after.stockReserved == false
            && data.onHand == before.onHand && data.reserved == before.reserved - quantity)
          || (data.action == 'done' && after.status == 'done' && order.status == 'ready' && after.stockReserved == false
            && data.onHand == before.onHand - quantity && data.reserved == before.reserved - (order.get('stockReserved',false) ? quantity : 0)));
      }
      function validRestock() {
        let before = resource == null ? {'onHand':0,'reserved':0} : resource.data;
        let movement = getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId)).data;
        return stockEditor() && request.resource.data.action == 'restock'
          && request.resource.data.reserved == before.reserved
          && request.resource.data.onHand == before.onHand + movement.quantity
          && movement.product == key && movement.timestamp == request.time && movement.actorEmail == email()
          && !exists(/databases/$(database)/documents/stockMovements/$(request.resource.data.movementId));
      }
      function validClosing() {
        let before = resource == null ? {'onHand':0,'reserved':0} : resource.data;
        let date = request.resource.data.countDate;
        let count = getAfter(/databases/$(database)/documents/stockCounts/$(date)).data;
        return stockEditor() && request.resource.data.action == 'closing'
          && !exists(/databases/$(database)/documents/stockCounts/$(date))
          && count.timestamp == request.time && count.actorEmail == email()
          && request.resource.data.onHand == count.items[key].actual
          && count.items[key].expected == before.onHand
          && request.resource.data.reserved == before.reserved;
      }
      function validWithdrawal() {
        let before = resource == null ? {'onHand':0,'reserved':0} : resource.data;
        let record = getAfter(/databases/$(database)/documents/stockWithdrawals/$(request.resource.data.withdrawalId)).data;
        return !exists(/databases/$(database)/documents/stockWithdrawals/$(request.resource.data.withdrawalId))
          && record.timestamp == request.time && record.actorEmail == email()
          && request.resource.data.onHand == before.onHand - record.items[key]
          && request.resource.data.reserved == before.reserved;
      }
      allow read: if staff();
      allow create, update: if staff() && key in ['p1','p2','p3','p4','p5','p6','p7']
        && request.resource.data.onHand is int && request.resource.data.onHand >= 0 && request.resource.data.onHand <= 10000000
        && request.resource.data.reserved is int && request.resource.data.reserved >= 0 && request.resource.data.reserved <= request.resource.data.onHand
        && request.resource.data.updatedBy == staffName() && request.resource.data.updatedByEmail == email()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['onHand','reserved','action','orderId','countDate','movementId','withdrawalId','updatedBy','updatedByEmail','updatedAt'])
        && ((request.resource.data.action == 'restock' && validRestock())
          || (request.resource.data.action == 'closing' && validClosing())
          || (request.resource.data.action == 'withdrawal' && validWithdrawal())
          || (request.resource.data.action in ['approved','cancelled','done'] && validOrderMovement()));
      allow delete: if false;
    }
    match /orders/{orderId} {
      function stockAcknowledged(key) {
        let quantity = orderQuantity(resource.data,key);
        return quantity == 0 || (getAfter(/databases/$(database)/documents/inventory/$(key)).data.orderId == orderId
          && getAfter(/databases/$(database)/documents/inventory/$(key)).data.action == request.resource.data.status
          && getAfter(/databases/$(database)/documents/inventory/$(key)).data.updatedAt == request.time);
      }
      function validOrderStock() {
        let before = resource.data;
        let after = request.resource.data;
        let touchesStock = after.status == 'approved' || after.status == 'done' || (after.status == 'cancelled' && before.get('stockReserved',false));
        return (!touchesStock && (after.get('stockReserved',false) == before.get('stockReserved',false) || (after.status == 'cancelled' && after.stockReserved == false)))
          || (touchesStock && after.stockReserved == (after.status == 'approved')
            && ((before.get('items',{}).size() > 0 && before.items.keys().hasOnly(['p1','p2','p3','p4','p5','p6','p7'])) || before.get('product','') in ['p1','p2','p3','p4','p5','p6','p7'])
            && stockAcknowledged('p1') && stockAcknowledged('p2') && stockAcknowledged('p3') && stockAcknowledged('p4') && stockAcknowledged('p5') && stockAcknowledged('p6') && stockAcknowledged('p7'));
      }
      function validAmounts(data) {
        return data.unitPrices == {'p1':50000,'p2':30000,'p3':70000,'p4':40000,'p5':25000,'p6':16000,'p7':20000}
          && data.currency == 'MNT'
          && data.subtotal == data.items.get('p1',0)*50000 + data.items.get('p2',0)*30000 + data.items.get('p3',0)*70000 + data.items.get('p4',0)*40000 + data.items.get('p5',0)*25000 + data.items.get('p6',0)*16000 + data.items.get('p7',0)*20000
          && data.discount is int && data.discount >= 0 && data.discount <= data.subtotal
          && data.total == data.subtotal - data.discount && data.amountPaid == 0;
      }
      function validQuantity(items, key) {
        return !(key in items) || (items[key] is int && items[key] > 0 && items[key] <= 10000);
      }
      function validItems(items) {
        return items is map && items.size() > 0
          && items.keys().hasOnly(['p1','p2','p3','p4','p5','p6','p7'])
          && validQuantity(items, 'p1') && validQuantity(items, 'p2')
          && validQuantity(items, 'p3') && validQuantity(items, 'p4')
          && validQuantity(items, 'p5') && validQuantity(items, 'p6') && validQuantity(items, 'p7')
          && request.resource.data.qty == items.get('p1',0) + items.get('p2',0) + items.get('p3',0) + items.get('p4',0) + items.get('p5',0) + items.get('p6',0) + items.get('p7',0);
      }
      allow read: if signedIn() && (staff() || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.qty <= 70000
        && ((!request.resource.data.keys().hasAny(['channel', 'createdBy', 'approvedBy', 'status'])
          && request.resource.data.keys().hasOnly(['name', 'phone', 'product', 'qty', 'email', 'note', 'lang', 'timestamp', 'uid', 'userEmail']))
          || (staff() && request.resource.data.channel == 'staff'
            && request.resource.data.status == 'new'
            && request.resource.data.createdBy == staffName()
            && request.resource.data.createdByRole == role()
            && request.resource.data.createdByEmail == email()
            && validItems(request.resource.data.items)
            && validAmounts(request.resource.data)
            && request.resource.data.source in ['phone','market','website','facebook','other']
            && request.resource.data.sourceDetail is string
            && (!(request.resource.data.source in ['market','other']) || request.resource.data.sourceDetail.size() > 0)
            && request.resource.data.address is string && request.resource.data.address.size() > 0
            && request.resource.data.promisedDate is string
            && request.resource.data.promisedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.deliveryAssignee in ['belguutei66@gmail.com','bayanaa1250@gmail.com','bbolor0411@gmail.com','delivery-pending']
            && request.resource.data.deliveryAssigneeName == (request.resource.data.deliveryAssignee == 'belguutei66@gmail.com' ? 'ADMIN' : request.resource.data.deliveryAssignee == 'bayanaa1250@gmail.com' ? 'О. Баянжаргал' : request.resource.data.deliveryAssignee == 'bbolor0411@gmail.com' ? 'А. Болормаа' : 'У. Тогтуунбаатар')
            && request.resource.data.keys().hasOnly(['name','phone','items','qty','source','sourceDetail','address','email','note','status','channel','uid','userEmail','createdBy','createdByRole','createdByEmail','timestamp','lang','promisedDate','deliveryAssignee','deliveryAssigneeName','unitPrices','currency','subtotal','discount','total','amountPaid'])));
      allow update: if (signedIn() && resource.data.uid == request.auth.uid
          && resource.data.get('channel', '') != 'staff'
          && resource.data.get('status', 'new') in ['new', 'called']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (staff()
          && request.resource.data.updatedBy == staffName()
          && request.resource.data.updatedByEmail == email()
          && request.resource.data.updatedAt == request.time
          && validOrderStock()
          && ((manager() && resource.data.get('status','new') in ['new','called'] && request.resource.data.status == 'approved'
            && request.resource.data.approvedBy == staffName()
            && request.resource.data.approvedByEmail == email()
            && request.resource.data.approvedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedByEmail','updatedAt','approvedBy','approvedByEmail','approvedAt','stockReserved']))
          || (!(resource.data.get('status','new') in ['done','cancelled']) && request.resource.data.status == 'cancelled'
            && request.resource.data.cancellationReason == 'Захиалагч цуцалсан'
            && request.resource.data.cancellationNote is string && request.resource.data.cancellationNote.size() <= 2000
            && request.resource.data.cancelledBy == staffName() && request.resource.data.cancelledByEmail == email() && request.resource.data.cancelledAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedByEmail','updatedAt','cancellationReason','cancellationNote','cancelledBy','cancelledByEmail','cancelledAt','stockReserved']))
          || (resource.data.status == 'cancelled' && request.resource.data.status == 'new'
            && request.resource.data.recoveredBy == staffName() && request.resource.data.recoveredByEmail == email() && request.resource.data.recoveredAt == request.time
            && !request.resource.data.keys().hasAny(['approvedBy','approvedByEmail','approvedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedByEmail','updatedAt','recoveredBy','recoveredByEmail','recoveredAt','approvedBy','approvedByEmail','approvedAt']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedByEmail','updatedAt','deliveredBy','deliveredByEmail','deliveredAt','stockReserved'])
            && ((request.resource.data.status == 'done' && request.resource.data.deliveredBy == staffName() && request.resource.data.deliveredByEmail == email() && request.resource.data.deliveredAt == request.time)
              || (request.resource.data.status != 'done' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredBy','deliveredByEmail','deliveredAt'])))
            && ((resource.data.status in ['approved','paid'] && request.resource.data.status == 'ready' && (manager() || role() in ['accountant','production']))
              || (resource.data.status == 'ready' && request.resource.data.status == 'done' && (manager() || (role() != 'founder' && resource.data.deliveryAssignee == email())))
              ))));
      match /activity/{eventId} {
        allow read: if staff();
        allow create: if staff()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorEmail == email()
          && request.resource.data.actorName == staffName()
          && request.resource.data.actorRole == role()
          && request.resource.data.timestamp == request.time
          && ((request.resource.data.kind == 'created'
            && !exists(/databases/$(database)/documents/orders/$(orderId))
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.createdByEmail == email()
            && request.resource.data.status == 'new'
            && request.resource.data.keys().hasOnly(['kind','status','actorUid','actorEmail','actorName','actorRole','timestamp']))
          || (request.resource.data.kind == 'status'
            && request.resource.data.previousStatus == get(/databases/$(database)/documents/orders/$(orderId)).data.get('status','new')
            && request.resource.data.status != request.resource.data.previousStatus
            && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.updatedByEmail == email()
            && request.resource.data.note is string && request.resource.data.note.size() <= 2000
            && request.resource.data.keys().hasOnly(['kind','previousStatus','status','note','actorUid','actorEmail','actorName','actorRole','timestamp']))
          || (request.resource.data.kind == 'deliveryAttempt'
            && request.resource.data.note == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.deliveryAttemptReason
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.deliveryAttemptAt == request.time
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.deliveryAttemptByEmail == email()
            && request.resource.data.keys().hasOnly(['kind','note','actorUid','actorEmail','actorName','actorRole','timestamp']))
          || (request.resource.data.kind == 'payment' && role() in ['admin','founder','accountant']
            && request.resource.data.previousAmount == get(/databases/$(database)/documents/orders/$(orderId)).data.get('amountPaid',0)
            && request.resource.data.amountPaid == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.amountPaid
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.paymentRecordedAt == request.time
            && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.paymentRecordedByEmail == email()
            && request.resource.data.note is string && request.resource.data.note.size() <= 500
            && request.resource.data.keys().hasOnly(['kind','previousAmount','amountPaid','note','actorUid','actorEmail','actorName','actorRole','timestamp'])));
        allow update, delete: if false;
      }
      allow delete: if false;
      allow update: if staff() && role() in ['admin','founder','accountant']
        && resource.data.get('status','new') != 'cancelled'
        && resource.data.total is int
        && request.resource.data.amountPaid is int && request.resource.data.amountPaid >= 0 && request.resource.data.amountPaid <= resource.data.total
        && request.resource.data.paymentNote is string && request.resource.data.paymentNote.size() <= 500
        && request.resource.data.paymentRecordedBy == staffName()
        && request.resource.data.paymentRecordedByEmail == email()
        && request.resource.data.paymentRecordedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountPaid','paymentNote','paymentRecordedBy','paymentRecordedByEmail','paymentRecordedAt']);
      allow update: if staff() && resource.data.status == 'ready'
        && (manager() || resource.data.deliveryAssignee == email())
        && request.resource.data.deliveryAttemptReason is string && request.resource.data.deliveryAttemptReason.size() > 0 && request.resource.data.deliveryAttemptReason.size() <= 1000
        && request.resource.data.deliveryAttemptBy == staffName() && request.resource.data.deliveryAttemptByEmail == email()
        && request.resource.data.deliveryAttemptAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryAttemptReason','deliveryAttemptBy','deliveryAttemptByEmail','deliveryAttemptAt']);
    }
  }
}
